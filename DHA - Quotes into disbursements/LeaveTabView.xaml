<UserControl x:Class="DHA.DSTC.WPF.LeaveTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DHA.DSTC.WPF"
             IsVisibleChanged="LeaveTabView_IsVisibleChanged">
    <!-- Leave tab (DHA-9 phase B): My leave for everyone; Approvals and My team for approvers and HR (parity plan M1) -->
    <TabControl x:Name="LeaveSubTabs" Margin="8,8,8,0">
        <TabItem Header="My leave">
            <local:LeaveView/>
        </TabItem>
        <TabItem x:Name="ApprovalsTabItem" Header="Approvals" Visibility="Collapsed">
            <local:LeaveApprovalsView x:Name="ApprovalsView"/>
        </TabItem>
        <TabItem x:Name="TeamTabItem" Header="My team" Visibility="Collapsed">
            <local:LeaveTeamView x:Name="TeamView"/>
        </TabItem>
    </TabControl>
</UserControl>
