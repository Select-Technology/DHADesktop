<UserControl x:Class="DHA.DSTC.WPF.LeaveApprovalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="ApprovalsView_IsVisibleChanged">
    <!-- Leave approvals for HR (DHA-9 phase B). Styles come from MainWindow.Resources, hence DynamicResource. -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="360" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- Waiting for a decision + who's off -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Refresh" Width="90" Height="30"
                                Style="{DynamicResource SecondaryButtonStyle}" Click="RefreshButton_Click"/>
                        <TextBlock x:Name="PendingTitleText" Text="Waiting for a decision" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid x:Name="PendingGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionChanged="PendingGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="140"/>
                            <DataGridTextColumn Header="Dates" Binding="{Binding DatesText}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding LeaveTypeName}" Width="110"/>
                            <DataGridTextColumn Header="Days" Binding="{Binding Days, StringFormat=0.##}" Width="55"/>
                            <DataGridTextColumn Header="Waiting for" Binding="{Binding StatusText}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Who's off (next 30 days)" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <DataGrid x:Name="UpcomingGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="140"/>
                            <DataGridTextColumn Header="Dates" Binding="{Binding DatesText}" Width="*"/>
                            <DataGridTextColumn Header="Days" Binding="{Binding Days, StringFormat=0.##}" Width="55"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Decision panel -->
        <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
            <Grid>
                <TextBlock x:Name="NothingSelectedText" Text="Select a request to review it."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic"/>
                <ScrollViewer x:Name="DetailPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DetailKindText" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <TextBlock Text="Dates" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBlock x:Name="DetailDatesText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Type" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBlock x:Name="DetailTypeText" Margin="0,0,0,8"/>
                        <TextBlock Text="Length" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBlock x:Name="DetailHoursText" Margin="0,0,0,8"/>
                        <TextBlock Text="Requested" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBlock x:Name="DetailRequestedText" Margin="0,0,0,8"/>
                        <TextBlock Text="Their comments" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBlock x:Name="DetailCommentsText" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Their balance" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="DetailBalanceText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock x:Name="DetailOverlapText" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="#B45309" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Your comment (sent back to them)" Style="{DynamicResource FormLabelStyle}"/>
                        <TextBox x:Name="ApproverCommentTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ApproveButton" Grid.Column="0" Content="Approve" Height="36"
                                    Style="{DynamicResource PrimaryButtonStyle}" Click="ApproveButton_Click"/>
                            <Button x:Name="RejectButton" Grid.Column="2" Content="Reject" Height="36"
                                    Style="{DynamicResource SecondaryButtonStyle}" Click="RejectButton_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
