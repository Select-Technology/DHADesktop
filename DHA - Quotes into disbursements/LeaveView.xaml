<UserControl x:Class="DHA.DSTC.WPF.LeaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="LeaveView_IsVisibleChanged">
    <!-- Leave booking (DHA-9 phase B). Styles come from MainWindow.Resources, hence DynamicResource. -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="260"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- Request form -->
        <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Request Leave" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="From" Style="{DynamicResource FormLabelStyle}"/>
                    <DatePicker x:Name="StartDatePicker" Margin="0,0,0,12" Height="32" SelectedDateChanged="Date_Changed"/>

                    <TextBlock Text="To" Style="{DynamicResource FormLabelStyle}"/>
                    <DatePicker x:Name="EndDatePicker" Margin="0,0,0,12" Height="32" SelectedDateChanged="Date_Changed"/>

                    <TextBlock Text="Length" Style="{DynamicResource FormLabelStyle}"/>
                    <WrapPanel Margin="0,0,0,12">
                        <RadioButton x:Name="FullDayRadio" Content="Full day(s)" IsChecked="True" Margin="0,0,12,4" Checked="Length_Changed"/>
                        <RadioButton x:Name="MorningRadio" Content="Morning" Margin="0,0,12,4" Checked="Length_Changed"/>
                        <RadioButton x:Name="AfternoonRadio" Content="Afternoon" Margin="0,0,12,4" Checked="Length_Changed"/>
                        <RadioButton x:Name="CustomTimesRadio" Content="Set times" Margin="0,0,12,4" Checked="Length_Changed"/>
                    </WrapPanel>

                    <Grid x:Name="CustomTimesPanel" Margin="0,0,0,12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Start time (first day)" Style="{DynamicResource FormLabelStyle}"/>
                            <TextBox x:Name="StartTimeTextBox" Text="09:00" Height="32" VerticalContentAlignment="Center" TextChanged="Time_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="End time (last day)" Style="{DynamicResource FormLabelStyle}"/>
                            <TextBox x:Name="EndTimeTextBox" Text="17:30" Height="32" VerticalContentAlignment="Center" TextChanged="Time_Changed"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Type" Style="{DynamicResource FormLabelStyle}"/>
                    <ComboBox x:Name="LeaveTypeComboBox" Margin="0,0,0,4" Height="32" SelectionChanged="Type_Changed"/>
                    <TextBlock Text="Only you, your approver and HR can see the type. Your timesheet just says &quot;Approved leave&quot;."
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="Comments" Style="{DynamicResource FormLabelStyle}"/>
                    <TextBox x:Name="CommentsTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                    <!-- Live preview from the same calculator the server uses -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="PreviewTotalText" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PreviewDetailText" FontSize="11" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="SubmitButton" Content="Request leave" Height="36"
                            Style="{DynamicResource PrimaryButtonStyle}" Click="SubmitButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Balance and my requests -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock x:Name="BalanceTitleText" Text="My Balance" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="4">
                        <StackPanel>
                            <TextBlock Text="Entitlement" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="EntitlementText" FontSize="20" FontWeight="SemiBold" Text="–"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Taken" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TakenText" FontSize="20" FontWeight="SemiBold" Text="–"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Booked" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="BookedText" FontSize="20" FontWeight="SemiBold" Text="–"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Remaining" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="RemainingText" FontSize="20" FontWeight="SemiBold" Text="–" Foreground="#047857"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock x:Name="PendingText" FontSize="11" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="My Requests" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <DataGrid x:Name="RequestsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionChanged="RequestsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dates" Binding="{Binding DatesText}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding LeaveTypeName}" Width="110"/>
                            <DataGridTextColumn Header="Hours" Binding="{Binding Hours, StringFormat=0.##}" Width="60"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="150"/>
                            <DataGridTextColumn Header="Approver" Binding="{Binding ApproverName}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="RefreshButton" Content="Refresh" Width="90" Height="32" Margin="0,0,8,0"
                                Style="{DynamicResource SecondaryButtonStyle}" Click="RefreshButton_Click"/>
                        <Button x:Name="CancelRequestButton" Content="Cancel request" Width="130" Height="32" IsEnabled="False"
                                Style="{DynamicResource SecondaryButtonStyle}" Click="CancelRequestButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
